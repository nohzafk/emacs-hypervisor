#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

elle_bin=${ELLE_BIN:-"$repo_dir/.elle/target/release/elle"}
store_dir=${ELLE_MCP_STORE:-"$repo_dir/.elle-mcp/store"}

has_oxigraph_plugin() {
    for path in \
        "$repo_dir/.elle/target/release/libelle_oxigraph.dylib" \
        "$repo_dir/.elle/target/release/libelle_oxigraph.so" \
        "$repo_dir/.elle/target/debug/libelle_oxigraph.dylib" \
        "$repo_dir/.elle/target/debug/libelle_oxigraph.so"; do
        if [ -f "$path" ]; then
            return 0
        fi
    done

    return 1
}

resolve_server() {
    if [ -n "${ELLE_MCP_SERVER:-}" ] && [ -f "${ELLE_MCP_SERVER}" ]; then
        printf '%s\n' "${ELLE_MCP_SERVER}"
        return 0
    fi

    for path in \
        "$repo_dir/.elle/mcp/mcp-server.lisp" \
        "$repo_dir/.elle/mcp/tools/mcp-server.lisp" \
        "$repo_dir/.vendor/elle-mcp/mcp-server.lisp" \
        "$repo_dir/.vendor/elle-mcp/tools/mcp-server.lisp" \
        "$repo_dir/../elle-mcp/mcp-server.lisp" \
        "$repo_dir/../elle-mcp/tools/mcp-server.lisp"; do
        if [ -f "$path" ]; then
            printf '%s\n' "$path"
            return 0
        fi
    done

    return 1
}

if ! server_file=$(resolve_server); then
    cat <<'EOF' >&2
Elle MCP server not found.

Expected one of:
- ELLE_MCP_SERVER=/path/to/mcp-server.lisp
- .elle/mcp/mcp-server.lisp
- .elle/mcp/tools/mcp-server.lisp
- ../elle-mcp/mcp-server.lisp
- ../elle-mcp/tools/mcp-server.lisp
- .vendor/elle-mcp/mcp-server.lisp
- .vendor/elle-mcp/tools/mcp-server.lisp

Once available, this wrapper will start the MCP server with a repo-local store
at .elle-mcp/store by default.
EOF
    exit 1
fi

if [ ! -x "$elle_bin" ]; then
    cat >&2 <<EOF
Elle binary not found at:
- $elle_bin

Set ELLE_BIN to an existing Elle binary or run:
- tools/bootstrap-elle
EOF
    exit 1
fi

if ! has_oxigraph_plugin; then
    cat >&2 <<'EOF'
Elle MCP plugin not found.

Expected one of:
- .elle/target/release/libelle_oxigraph.dylib
- .elle/target/release/libelle_oxigraph.so
- .elle/target/debug/libelle_oxigraph.dylib
- .elle/target/debug/libelle_oxigraph.so

Run:
- tools/bootstrap-elle

That bootstrap flow builds the repo-local Elle binary and the MCP plugins in
one pass.
EOF
    exit 1
fi

mkdir -p "$store_dir"
cd "$repo_dir"
exec "$elle_bin" "$server_file" -- "$store_dir"
