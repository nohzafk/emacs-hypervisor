+            // Write short-write completion: a pipe or socket accepts at most
+            // its buffer capacity per write, so a single message larger than
+            // that (e.g. a >64KB protocol line) legally completes short.  The
+            // tail must not be dropped — finish it with a synchronous write
+            // loop, mirroring the thread-pool backend's PoolOp::Write loop.
+            // The buffer outlives the CQE in the pool, so the remainder is
+            // still there.
+            let mut result_code = result_code;
+            if let PendingOp::Port {
+                op: IoOp::Write { .. },
+                ref port_key,
+                ..
+            } = pending_op
+            {
+                let payload_len = buffer_pool.get_mut(buf_handle).len();
+                if result_code > 0 && (result_code as usize) < payload_len {
+                    let fd = match port_key {
+                        PortKey::Fd(raw) => *raw,
+                        PortKey::Stdout => 1,
+                        PortKey::Stderr => 2,
+                        PortKey::Stdin => unreachable!(),
+                    };
+                    let buf = buffer_pool.get_mut(buf_handle);
+                    let mut total = result_code as usize;
+                    while total < payload_len {
+                        let ret = unsafe {
+                            libc::write(
+                                fd,
+                                buf[total..].as_ptr() as *const libc::c_void,
+                                payload_len - total,
+                            )
+                        };
+                        if ret < 0 {
+                            let err = std::io::Error::last_os_error();
+                            match err.raw_os_error() {
+                                Some(libc::EINTR) => continue,
+                                Some(libc::EAGAIN) => {
+                                    // Non-blocking fd with a full buffer: wait
+                                    // for writability, then retry.
+                                    let mut pfd = libc::pollfd {
+                                        fd,
+                                        events: libc::POLLOUT,
+                                        revents: 0,
+                                    };
+                                    unsafe { libc::poll(&mut pfd, 1, 1000) };
+                                    continue;
+                                }
+                                _ => {
+                                    result_code =
+                                        -(err.raw_os_error().unwrap_or(libc::EIO));
+                                    break;
+                                }
+                            }
+                        }
+                        total += ret as usize;
+                    }
+                    if result_code > 0 {
+                        result_code = total as i32;
+                    }
+                }
+            }
+
