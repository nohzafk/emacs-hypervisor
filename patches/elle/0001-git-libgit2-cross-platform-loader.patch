diff --git a/lib/git.lisp b/lib/git.lisp
index f5be8c7a..c1046346 100644
--- a/lib/git.lisp
+++ b/lib/git.lisp
@@ -10,7 +10,32 @@
 ##   (git:close repo)
 
 (fn []
-  (def lib (ffi/native "libgit2.so"))
+  ## Locate libgit2 across platforms without requiring DYLD_LIBRARY_PATH /
+  ## LD_LIBRARY_PATH to be set by the caller.  We try, in order:
+  ##   1. the bare platform name, so an explicitly-set search path still wins;
+  ##   2. the common package-manager install dirs that are NOT on the default
+  ##      dynamic-linker search path (Homebrew, MacPorts, multiarch Linux).
+  ## The first candidate that loads wins; absolute paths that don't exist fail
+  ## fast and are skipped.
+  (defn load-libgit2 [names]
+    (if (empty? names)
+      (error (string "std/git: unable to load libgit2 "
+                     "(tried bare names and known install dirs)"))
+      (let [[ok? handle] (protect (ffi/native (first names)))]
+        (if ok? handle (load-libgit2 (slice names 1))))))
+  (def lib (load-libgit2
+             @[## macOS
+               "libgit2.dylib"
+               "/opt/homebrew/lib/libgit2.dylib"     ## Homebrew (Apple Silicon)
+               "/usr/local/lib/libgit2.dylib"        ## Homebrew (Intel)
+               "/opt/local/lib/libgit2.dylib"        ## MacPorts
+               ## Linux
+               "libgit2.so"
+               "libgit2.so.1"
+               "/usr/lib/libgit2.so"
+               "/usr/local/lib/libgit2.so"
+               "/usr/lib/x86_64-linux-gnu/libgit2.so"
+               "/usr/lib/aarch64-linux-gnu/libgit2.so"]))
   (def null-ptr (ptr/from-int 0))
 
   (defn cfn [name ret args]
