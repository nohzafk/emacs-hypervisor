#!/usr/bin/env bash
# hypervisor-env - Generate a repo-local env file for Emacs Hypervisor
# Usage: hypervisor-env [-o OUTPUT_FILE]

set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
output_file="$repo_root/env"

while [[ $# -gt 0 ]]; do
  case $1 in
    -o)
      output_file="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: hypervisor-env [-o OUTPUT_FILE]" >&2
      exit 1
      ;;
  esac
done

mkdir -p "$(dirname "$output_file")"

env | {
  env_vars=()
  while IFS= read -r line; do
    if [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
      env_vars+=("$line")
    fi
  done

  cat > "$output_file" <<'EOF'
;; -*- mode: lisp-interaction; coding: utf-8-unix; -*-
;; ---------------------------------------------------------------------------
;; This file was auto-generated by `bin/hypervisor-env'. It contains a list of
;; environment variables scraped from the current shell process.
;;
;; Emacs Hypervisor loads this file from repo-root `env` before `config.el`.

EOF

  echo "(" >> "$output_file"
  for var in "${env_vars[@]}"; do
    escaped="${var//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"
    printf ' "%s"\n' "$escaped" >> "$output_file"
  done
  echo ")" >> "$output_file"

  echo "Generated environment file: $output_file"
}
