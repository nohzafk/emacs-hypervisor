#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

bin_dir=${1:-"$HOME/.local/bin"}
hypervisor_binary="$repo_dir/target/release/emacs-hypervisor"

usage() {
  cat <<USAGE
usage: scripts/install-hypervisor [BIN_DIR]

Install the built emacs-hypervisor binary into BIN_DIR.

Runtime Elle plugins configured at build time are embedded in the binary and
do not need to be copied next to it.

Default BIN_DIR: $HOME/.local/bin
USAGE
}

case "${1-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

if [ "$#" -gt 1 ]; then
  usage >&2
  exit 64
fi

if [ ! -f "$hypervisor_binary" ]; then
  echo "missing built binary: $hypervisor_binary" >&2
  echo "run: just dev" >&2
  exit 1
fi

mkdir -p "$bin_dir"
rm -f "$bin_dir/emacs-hypervisor"
cp "$hypervisor_binary" "$bin_dir/emacs-hypervisor"

if [ "$(uname -s)" = "Darwin" ]; then
  codesign --force --sign - "$bin_dir/emacs-hypervisor"
fi
