#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

elle_dir=${ELLE_DIR:-"$repo_dir/.elle"}
store_dir=${ELLE_MCP_STORE:-"$repo_dir/.elle-mcp/store"}

usage() {
    cat <<EOF
usage: scripts/start-elle-mcp

Starts the repo-local Elle MCP server:
  cd "$elle_dir"
  target/release/elle mcp/mcp-server.lisp -- "$store_dir"
EOF
}

case "${1-}" in
    "")
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac

mkdir -p "$(dirname "$store_dir")"

cd "$elle_dir"
exec target/release/elle mcp/mcp-server.lisp -- "$store_dir"
