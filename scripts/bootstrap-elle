#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

# Shell UI helpers do not belong in Cargo's build environment.  Some Rust build
# scripts panic when non-UTF-8 prompt decoration values are present.
unset ABBR_TIPS_PROMPT

elle_dir=${ELLE_DIR:-"$repo_dir/.elle"}
elle_repo=${ELLE_REPO:-https://github.com/elle-lisp/elle.git}
default_elle_ref_file="$repo_dir/.elle-ref"
if [ -f "$default_elle_ref_file" ]; then
  IFS= read -r default_elle_ref < "$default_elle_ref_file" || default_elle_ref=""
else
  default_elle_ref=""
fi
if [ -z "$default_elle_ref" ]; then
  echo "missing default Elle ref in $default_elle_ref_file" >&2
  exit 1
fi
elle_ref=${ELLE_REF-$default_elle_ref}
elle_build_mcp_plugins=${ELLE_BUILD_MCP_PLUGINS:-}
elle_checkout_only=0
elle_bin="$elle_dir/target/release/elle"
elle_patches_dir="$repo_dir/patches/elle"

usage() {
  cat <<EOF
usage: scripts/bootstrap-elle [--checkout-only] [--mcp-plugins]

Clone Elle into the repo-local .elle checkout if needed, apply repo-local
patches from patches/elle/*.patch on top of the pinned upstream ref, and build
the release binary.  With --mcp-plugins, also initialize submodules and build
the MCP Elle plugins (oxigraph, syn) for development use.

With --checkout-only, stop after cloning/fetching the repo-local Elle checkout
and checking out the configured ref.  This is useful before restoring cargo
target caches that live below .elle.

Runtime Elle plugins from .elle-plugins are built by scripts/build-hypervisor.
MCP Elle plugins are local development tooling and are not part of the normal
Hypervisor runtime build.

Artifacts (always):
- .elle/target/release/elle

Artifacts (--mcp-plugins / ELLE_BUILD_MCP_PLUGINS=1):
- .elle/target/release/libelle_oxigraph.{dylib,so}
- .elle/target/release/libelle_syn.{dylib,so}

Environment overrides:
- ELLE_DIR  destination checkout directory (default: $repo_dir/.elle)
- ELLE_REPO clone URL (default: $elle_repo)
- ELLE_REF  pin to a specific commit/branch/tag
            (default: project pin from $default_elle_ref_file; set ELLE_REF= to keep
            the checkout at its current ref)
- ELLE_BUILD_MCP_PLUGINS  when set to a non-empty value, build the MCP Elle plugins
  (oxigraph, syn) in addition to the elle binary.  Equivalent to --mcp-plugins.
- LIBCLANG_PATH  passed through to the MCP Elle plugin build; on macOS this script
  auto-detects Xcode, Command Line Tools, and common package-manager libclang
  installs when available
EOF
}

libclang_file_names() {
  case "$(uname -s)" in
    Darwin)
      printf '%s\n' "libclang.dylib"
      ;;
    *)
      printf '%s\n' "libclang.so" "libclang.so.1"
      ;;
  esac
}

directory_has_libclang() {
  local directory=$1
  local file_name

  [ -d "$directory" ] || return 1

  while IFS= read -r file_name; do
    if [ -f "$directory/$file_name" ]; then
      return 0
    fi
  done < <(libclang_file_names)

  return 1
}

print_libclang_directory_if_valid() {
  local candidate=$1

  if directory_has_libclang "$candidate"; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

detect_libclang_path() {
  if [ -n "${LIBCLANG_PATH:-}" ]; then
    printf '%s\n' "$LIBCLANG_PATH"
    return 0
  fi

  case "$(uname -s)" in
    Darwin)
      local developer_dir=""

      if command -v xcode-select >/dev/null 2>&1; then
        developer_dir=$(xcode-select -p 2>/dev/null || true)
      fi

      for candidate in \
        "${developer_dir:+$developer_dir/usr/lib}" \
        "${developer_dir:+$developer_dir/../Frameworks}" \
        "${developer_dir:+$developer_dir/Toolchains/XcodeDefault.xctoolchain/usr/lib}" \
        /Library/Developer/CommandLineTools/usr/lib \
        /Applications/Xcode.app/Contents/Frameworks \
        /Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/lib \
        /opt/homebrew/opt/llvm/lib \
        /usr/local/opt/llvm/lib \
        /opt/local/libexec/llvm-*/lib; do
        [ -n "$candidate" ] || continue

        if print_libclang_directory_if_valid "$candidate"; then
          return 0
        fi
      done
      ;;
    *)
      for candidate in \
        /usr/lib/llvm-*/lib \
        /usr/local/opt/llvm/lib \
        /usr/local/lib \
        /usr/lib \
        /usr/lib64; do
        if print_libclang_directory_if_valid "$candidate"; then
          return 0
        fi
      done
      ;;
  esac

  return 1
}

# Repo-local patches applied on top of the upstream Elle checkout.
# These carry any fixes we maintain against the pinned upstream ref, so a fresh
# clone of upstream Elle gains them automatically.  Patches are git-diff format
# under patches/elle/*.patch and are reverted before checkout and (re)applied
# after, keeping the operation idempotent across reruns and ref changes.
# Shipped patches are candidates for upstream submission; see each patch
# header and docs/spec-lockfile-check-source-map.md for context.
revert_elle_patches() {
  [ -d "$elle_patches_dir" ] || return 0
  local patch
  for patch in "$elle_patches_dir"/*.patch; do
    [ -e "$patch" ] || continue
    if git -C "$elle_dir" apply --reverse --check "$patch" >/dev/null 2>&1; then
      git -C "$elle_dir" apply --reverse "$patch"
    fi
  done
}

apply_elle_patches() {
  [ -d "$elle_patches_dir" ] || return 0
  local patch
  for patch in "$elle_patches_dir"/*.patch; do
    [ -e "$patch" ] || continue
    if git -C "$elle_dir" apply --reverse --check "$patch" >/dev/null 2>&1; then
      echo "Patch already applied: ${patch##*/}"
    elif git -C "$elle_dir" apply --check "$patch" >/dev/null 2>&1; then
      echo "Applying Elle patch: ${patch##*/}"
      git -C "$elle_dir" apply "$patch"
    else
      echo "error: failed to apply Elle patch (conflicts with pinned ref?): ${patch##*/}" >&2
      exit 1
    fi
  done
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --checkout-only)
      elle_checkout_only=1
      ;;
    --mcp-plugins)
      elle_build_mcp_plugins=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 64
      ;;
  esac
  shift
done

if ! command -v git >/dev/null 2>&1; then
  echo "git is required but was not found in PATH" >&2
  exit 1
fi

if [ "$elle_checkout_only" -eq 0 ] && ! command -v cargo >/dev/null 2>&1; then
  echo "cargo is required but was not found in PATH" >&2
  exit 1
fi

if [ -e "$elle_dir" ] && [ ! -d "$elle_dir/.git" ]; then
  cat >&2 <<EOF
Refusing to use existing path because it is not a git checkout:
- $elle_dir
EOF
  exit 1
fi

if [ ! -d "$elle_dir/.git" ]; then
  echo "Cloning Elle into $elle_dir"
  git clone "$elle_repo" "$elle_dir"
else
  echo "Using existing Elle checkout at $elle_dir"
fi

if [ -n "$elle_ref" ]; then
  echo "Checking out Elle ref: $elle_ref"
  # Revert our patches first so the working tree is pristine for checkout.
  revert_elle_patches
  git -C "$elle_dir" fetch --tags origin "$elle_ref" || git -C "$elle_dir" fetch --tags origin
  git -C "$elle_dir" checkout --quiet "$elle_ref"
fi

# Apply repo-local patches on top of the checked-out upstream ref.
apply_elle_patches

if [ "$elle_checkout_only" -ne 0 ]; then
  echo "Elle checkout ready."
  exit 0
fi

echo "Building Elle release binary"
(
  cd "$elle_dir"
  cargo build --release -p elle
)

if [ -n "$elle_build_mcp_plugins" ]; then
  echo "Initializing Elle submodules (needed for MCP Elle plugins)"
  git -C "$elle_dir" submodule update --init --recursive

  echo "Building MCP Elle plugins"
  if libclang_path=$(detect_libclang_path); then
    echo "Using LIBCLANG_PATH=$libclang_path"
    (
      cd "$elle_dir"
      env LIBCLANG_PATH="$libclang_path" make -C plugins mcp
    )
  else
    (
      cd "$elle_dir"
      make -C plugins mcp
    )
  fi
else
  echo "Skipping MCP Elle plugins (pass --mcp-plugins or ELLE_BUILD_MCP_PLUGINS=1 to build)"
fi

cat <<EOF
Elle bootstrap complete.

Artifacts:
- $elle_bin$(if [ -n "$elle_build_mcp_plugins" ]; then printf '\n- %s/target/release/libelle_oxigraph\n- %s/target/release/libelle_syn' "$elle_dir" "$elle_dir"; fi)
EOF
