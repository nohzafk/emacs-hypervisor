#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
manifest_path="$repo_dir/host/Cargo.toml"
lock_path="$repo_dir/host/Cargo.lock"
seed_lock_path="$repo_dir/.elle/Cargo.lock"
default_elle_plugins_file="$repo_dir/.elle-plugins"
target_dir=${CARGO_TARGET_DIR:-"$repo_dir/target"}
profile=release
cargo_args=(build --offline --locked --manifest-path "$manifest_path" --release)

# Shell UI helpers do not belong in Cargo's build environment.  Some Rust build
# scripts panic when non-UTF-8 prompt decoration values are present.
unset ABBR_TIPS_PROMPT

if [ -f "$default_elle_plugins_file" ]; then
  default_elle_plugins=$(tr '\n' ',' < "$default_elle_plugins_file" | sed 's/,$//')
else
  default_elle_plugins=""
fi
elle_plugins=${EMACS_HYPERVISOR_ELLE_PLUGINS:-$default_elle_plugins}

plugin_manifest_path() {
  local plugin_name=$1
  local local_manifest="$repo_dir/plugins/$plugin_name/Cargo.toml"

  if [ -f "$local_manifest" ]; then
    printf '%s\n' "$local_manifest"
  else
    printf '%s\n' "$repo_dir/.elle/plugins/Cargo.toml"
  fi
}

usage() {
  cat <<USAGE
usage: scripts/build-hypervisor [--debug]

Build the native emacs-hypervisor host binary that links the repo-local Elle
checkout at .elle.

Artifacts:
- $target_dir/release/emacs-hypervisor
- $target_dir/debug/emacs-hypervisor (with --debug)

Notes:
- builds requested runtime Elle plugins into .elle/target/release first so the
  host binary can embed them
- builds the host binary offline against the checked-in host lockfile
- if host/Cargo.lock is missing, it is seeded from .elle/Cargo.lock

Environment overrides:
- CARGO_TARGET_DIR  cargo target directory (default: $repo_dir/target)
- EMACS_HYPERVISOR_ELLE_PLUGINS  comma-separated Elle plugins required at
  runtime. Defaults to runtime Elle plugins from .elle-plugins.
USAGE
}

case "${1-}" in
  "")
    ;;
  --debug)
    profile=debug
    cargo_args=(build --offline --locked --manifest-path "$manifest_path")
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac

if ! command -v cargo >/dev/null 2>&1; then
  echo "cargo is required but was not found in PATH" >&2
  exit 1
fi

if [ -n "$elle_plugins" ] && ! command -v git >/dev/null 2>&1; then
  echo "git is required to initialize Elle submodules for runtime Elle plugins" >&2
  exit 1
fi

if [ ! -f "$repo_dir/.elle/Cargo.toml" ]; then
  cat >&2 <<EOF2
Missing repo-local Elle checkout at:
- $repo_dir/.elle

Run scripts/bootstrap-elle first, or provide the checkout at that path.
EOF2
  exit 1
fi

if [ ! -f "$lock_path" ]; then
  if [ ! -f "$seed_lock_path" ]; then
    cat >&2 <<EOF2
Missing lockfiles:
- $lock_path
- $seed_lock_path
EOF2
    exit 1
  fi
  cp "$seed_lock_path" "$lock_path"
fi

if [ -n "$elle_plugins" ]; then
  echo "Initializing Elle submodules (needed for runtime Elle plugins)"
  git -C "$repo_dir/.elle" submodule update --init --recursive

  IFS=',' read -r -a plugin_names <<< "$elle_plugins"
  for plugin_name in "${plugin_names[@]}"; do
    plugin_name=${plugin_name//[[:space:]]/}
    [ -n "$plugin_name" ] || continue
    plugin_manifest=$(plugin_manifest_path "$plugin_name")
    echo "Building runtime Elle plugin: $plugin_name"
    (
      cd "$repo_dir/.elle"
      cargo build --release --manifest-path "$plugin_manifest" --target-dir target -p "elle-$plugin_name"
    )
    case "$(uname -s)" in
      Darwin) plugin_ext=dylib ;;
      *) plugin_ext=so ;;
    esac
    plugin_path="$repo_dir/.elle/target/release/libelle_${plugin_name}.${plugin_ext}"
    if [ ! -f "$plugin_path" ]; then
      echo "Missing runtime Elle plugin artifact: $plugin_path" >&2
      echo "Check .elle-plugins or EMACS_HYPERVISOR_ELLE_PLUGINS, then rerun scripts/build-hypervisor." >&2
      exit 1
    fi
  done
fi

echo "Building emacs-hypervisor ($profile)"
CARGO_TARGET_DIR="$target_dir" cargo "${cargo_args[@]}"

echo
printf 'Built binary: %s/%s/emacs-hypervisor\n' "$target_dir" "$profile"
