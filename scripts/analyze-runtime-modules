#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

elle_bin=${ELLE_BIN:-"$repo_dir/.elle/target/release/elle"}
analysis_file="$repo_dir/scripts/analyze-runtime.lisp"

case "${1-}" in
"") ;;
--verbose | --full)
    export ANALYZE_RUNTIME_VERBOSE=1
    shift
    ;;
*)
    echo "usage: scripts/analyze-runtime-modules [--verbose]" >&2
    exit 64
    ;;
esac

if [ "$#" -ne 0 ]; then
    echo "usage: scripts/analyze-runtime-modules [--verbose]" >&2
    exit 64
fi

if [ ! -x "$elle_bin" ]; then
    cat >&2 <<EOF
Elle binary not found at:
- $elle_bin

Set ELLE_BIN to an existing Elle binary or run:
- scripts/bootstrap-elle
EOF
    exit 1
fi

cd "$repo_dir"
exec "$elle_bin" "$analysis_file"
